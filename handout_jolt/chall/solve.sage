res = res.split("\n\n")

def a2b(aa):
    assert len(aa) == 10
    b = vector(F, 5)
    for i in range(5):
        b[i] = aa[2 * i] - aa[2 * i + 1]
    return b

base = [ZZ(rr.split(" = ")[1]) for rr in base.split("\n")]
base = a2b(base)

M = []
vals = []
for r in res:
    r = r.split("\n")
    r2 = []
    for rr in r:
        if len(rr):
            r2.append(rr)
    val = int(r2[0])
    r2 = r2[1:]
    r3 = [ZZ(rr.split(" = ")[1]) for rr in r2]
    assert len(r3) == 10

    rr = a2b(r3) - base
    # print(rr)
    M.append(rr)
    vals.append(val)

print(M)

M = Matrix(F, M)
sol = M.solve_left(-base)
for s in sol:
    s = ZZ(s)
    s = list(s.to_bytes(32, "little"))
    print(s)
print(vals)